[Unit]
Description=InkPi Cloud Control Plane
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__SERVICE_USER__
Group=__SERVICE_GROUP__
WorkingDirectory=__WORKDIR__
Environment=HOME=__SERVICE_HOME__
Environment=PATH=__SERVICE_PATH__
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/inkpi/cloud.env
ExecStart=__BACKEND_BIN__/inkpi-api --host 0.0.0.0 --port 8080 --web-dist __FRONTEND_DIST__
Restart=always
RestartSec=5
TimeoutStopSec=45
SuccessExitStatus=143 SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/inkpi

[Install]
WantedBy=multi-user.target
