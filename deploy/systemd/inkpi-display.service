[Unit]
Description=InkPi E-Ink Display Service
After=local-fs.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__SERVICE_USER__
Group=__SERVICE_GROUP__
WorkingDirectory=__WORKDIR__
Environment=HOME=__SERVICE_HOME__
Environment=PATH=__SERVICE_PATH__
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/inkpi/pi-display.env
ExecStart=__BACKEND_BIN__/inkpi-display
Restart=always
RestartSec=5
TimeoutStopSec=45
SuccessExitStatus=143 SIGTERM
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
