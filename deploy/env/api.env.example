# Copy to ~/.config/inkpi/api.env on the Raspberry Pi.
# Set owner to the service user and mode to 0600.

INKPI_ADMIN_TOKEN=replace-with-a-long-random-value

# Recommended when display telemetry may cross a non-loopback interface.
INKPI_DISPLAY_TOKEN=replace-with-a-long-random-value

# Required only when enrolling a remote host agent.
INKPI_AGENT_ENROLLMENT_TOKEN=replace-with-a-long-random-value

# Optional. Used in memory to render the hotspot Wi-Fi QR code after restart.
INKPI_HOTSPOT_PASSWORD=
