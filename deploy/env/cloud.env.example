# Cloud control-plane secrets and persistent paths.
# Installed as root:root 0600 at /etc/inkpi/cloud.env.
INKPI_ADMIN_TOKEN=replace-with-a-long-random-token
INKPI_DISPLAY_TOKEN=replace-with-a-different-long-random-token
INKPI_AGENT_ENROLLMENT_TOKEN=replace-with-another-long-random-token
INKPI_DATABASE_URL=sqlite+pysqlite:////var/lib/inkpi/inkpi.db
INKPI_UPLOAD_DIR=/var/lib/inkpi/pages
INKPI_CHROMIUM_EXECUTABLE=/usr/bin/chromium
