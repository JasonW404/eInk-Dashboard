# Copy to ~/.config/inkpi/host-agent.env on the Ubuntu host.
# Set owner to the service user and mode to 0600.

INKPI_API_URL=http://inkpi.local:8080
INKPI_AGENT_NAME=ubuntu-main

# Remove this after the first successful registration.
INKPI_AGENT_ENROLLMENT_TOKEN=replace-with-the-value-configured-on-the-pi

# Required for private GitHub contribution data.
EINK_GITHUB_API_KEY=replace-with-a-github-token

# Optional override when Codex is not discoverable on PATH.
# CODEX_BINARY=/absolute/path/to/codex
