# InkPi Secrets Configuration
# Copy this file to .env and fill in your actual values.
# Non-secret configuration (GitHub username, display policy, etc.)
# belongs in ~/.config/inkpi/config.json — see backend/src/inkpi/config.py.

# GitHub Personal Access Token (for private repo data)
# Create at: https://github.com/settings/tokens
# Scopes needed: repo
EINK_GITHUB_API_KEY=github_pat_xxxxxxxxxxxxx

# Current hotspot password, used only to render the local eInk Wi-Fi QR code.
# Keep this synchronized after rotating the hotspot password.
INKPI_HOTSPOT_PASSWORD=
